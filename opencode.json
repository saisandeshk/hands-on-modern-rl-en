          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "timeout * .venv/bin/pytest *",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "doom_loop",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
