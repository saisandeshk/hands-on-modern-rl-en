{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "worker": {
      "description": "Headless worker for delegated repo tasks: reads and edits files inside the repo, runs only allowlisted git/build/lint/check commands, no web, no destructive git, cannot edit this config.",
      "mode": "primary",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "steps": 400,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "lsp",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*opencode.json",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*.opencode/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*.git/*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git ls-files*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git grep*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git mv *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rm *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run build",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run lint",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run format:check",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run verify",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run verify:*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run sitemap",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run fix:headings*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npx prettier *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npx eslint *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npx vitepress build*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "node scripts/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "node --test *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "bash scripts/verify.sh*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "python3 scripts/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "python3 -m py_compile *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": ".venv/bin/python *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": ".venv/bin/pytest *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "timeout * .venv/bin/python *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "timeout * .venv/bin/pytest *",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "doom_loop",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "reviewer": {
      "description": "Headless reviewer: reads the repo and git history, may only write review files under planning/reviews/.",
      "mode": "primary",
      "model": "opencode-go/minimax-m3.1-flash-free",
      "steps": 250,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*planning/reviews/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git ls-tree*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": ".venv/bin/python -c *",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "doom_loop",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "factcheck": {
      "description": "Fact-checker: like worker, plus web search and fetch for verifying citations and numbers.",
